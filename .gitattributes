# Normalización de fin de línea. Sin esto, un clone en Windows con
# core.autocrlf=true convierte los scripts de shell a CRLF y la imagen Docker
# muere al arrancar con "/bin/sh^M: bad interpreter".
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf

# Scripts de Windows: CRLF obligatorio.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binarios: sin conversión.
*.png       binary
*.jpg       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.traineddata binary
*.wasm      binary
