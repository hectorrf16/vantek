{
  "compilerOptions": {
    "target": "ES2022",
    // nodenext (no CommonJS/node10): TS7 eliminó moduleResolution node10. Sin
    // "type": "module" en el paquete, se sigue emitiendo CommonJS.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["launcher.ts"],
  "exclude": ["node_modules"]
}
